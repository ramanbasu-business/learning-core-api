<Project>
  <!-- Shared settings: every lesson is a tiny console project that references EfCoreLab.Common. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'EfCoreLab.Common'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)EfCoreLab.Common/EfCoreLab.Common.csproj" />
  </ItemGroup>
</Project>
